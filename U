local function parsePuzzleGrid(grid)
    local cells = {}
    local pairsMap = {}
    local maxR, maxC = 0, 0

    for _, child in ipairs(grid:GetChildren()) do
        if child:IsA("GuiObject") then
            local r, c = string.match(child.Name, "^(%d+)%-(%d+)$")
            if r and c then
                r, c = tonumber(r), tonumber(c)
                maxR = math.max(maxR, r)
                maxC = math.max(maxC, c)
                cells[r] = cells[r] or {}
                cells[r][c] = child

                local circle = child:FindFirstChild("Circle")
                local numLabel = circle and circle:FindFirstChild("Number")
                if numLabel and numLabel:IsA("TextLabel") then
                    local textValue = tostring(numLabel.Text or ""):match("^%s*(%d+)%s*$")
                    local n = tonumber(textValue)
                    if n then
                        pairsMap[n] = pairsMap[n] or {}
                        table.insert(pairsMap[n], {row = r, col = c, frame = child})
                    end
                end
            end
        end
    end
    return cells, pairsMap, math.max(maxR, maxC)
end

local function cellKey(r, c)
    return r * 100 + c
end

local DIRS4 = {{1, 0}, {-1, 0}, {0, 1}, {0, -1}}

local function reachable(cells, size, start, goal, blocked)
    local sk = cellKey(start.row, start.col)
    local gk = cellKey(goal.row, goal.col)
    if sk == gk then return true end
    local q = {{start.row, start.col}}
    local seen = {[sk] = true}
    local qi = 1
    while qi <= #q do
        local r, c = q[qi][1], q[qi][2]
        qi += 1
        for _, d in ipairs(DIRS4) do
            local nr, nc = r + d[1], c + d[2]
            if cells[nr] and cells[nr][nc] then
                local k = cellKey(nr, nc)
                if not seen[k] then
                    local isGoal = (k == gk)
                    if isGoal or not blocked[k] then
                        if isGoal then return true end
                        seen[k] = true
                        table.insert(q, {nr, nc})
                    end
                end
            end
        end
    end
    return false
end

local function collectPaths(cells, size, start, goal, blocked, maxPaths, deadline)
    maxPaths = maxPaths or 256
    deadline = deadline or (os.clock() + 1.5)
    local results = {}
    local path = {{row = start.row, col = start.col}}
    local visited = {[cellKey(start.row, start.col)] = true}
    local gr, gc = goal.row, goal.col
    local nodes = 0
    local maxLen = size * size

    local function dfs(r, c)
        if #results >= maxPaths or os.clock() > deadline then return end
        nodes += 1
        if nodes % 350 == 0 then task.wait() end
        if #path > maxLen then return end

        if r == gr and c == gc then
            local copy = {}
            for i = 1, #path do
                copy[i] = {row = path[i].row, col = path[i].col}
            end
            results[#results + 1] = copy
            return
        end

        local distance = math.abs(r - gr) + math.abs(c - gc)
        local remaining = maxLen - #path + 1
        if distance > remaining then return end

        local neigh = {}
        for _, d in ipairs(DIRS4) do
            local nr, nc = r + d[1], c + d[2]
            if cells[nr] and cells[nr][nc] then
                local k = cellKey(nr, nc)
                local isGoal = (nr == gr and nc == gc)
                if not visited[k] and (isGoal or not blocked[k]) then
                    neigh[#neigh + 1] = {
                        nr = nr,
                        nc = nc,
                        k = k,
                        dist = math.abs(nr - gr) + math.abs(nc - gc),
                    }
                end
            end
        end
        table.sort(neigh, function(a, b)
            if a.dist ~= b.dist then return a.dist < b.dist end
            return a.k < b.k
        end)

        for _, n in ipairs(neigh) do
            visited[n.k] = true
            path[#path + 1] = {row = n.nr, col = n.nc}
            dfs(n.nr, n.nc)
            path[#path] = nil
            visited[n.k] = nil
            if #results >= maxPaths or os.clock() > deadline then return end
        end
    end

    dfs(start.row, start.col)
    table.sort(results, function(a, b)
        if #a ~= #b then return #a > #b end
        return tostring(a[2] and a[2].row or 0) < tostring(b[2] and b[2].row or 0)
    end)
    return results
end

local function makeEndpointMap(pairList)
    local endpointKeys = {}
    for _, p in ipairs(pairList) do
        endpointKeys[cellKey(p.a.row, p.a.col)] = p.num
        endpointKeys[cellKey(p.b.row, p.b.col)] = p.num
    end
    return endpointKeys
end

local function freeSpaceFeasible(cells, size, pairList, solvedSet, occupied, endpointKeys)
    local free = {}
    for r = 1, size do
        for c = 1, size do
            if cells[r] and cells[r][c] then
                local k = cellKey(r, c)
                if not occupied[k] then
                    free[k] = true
                end
            end
        end
    end

    for _, p in ipairs(pairList) do
        if not solvedSet[p.num] then
            local ak = cellKey(p.a.row, p.a.col)
            local bk = cellKey(p.b.row, p.b.col)
            if not free[ak] or not free[bk] then return false end
        end
    end

    local seen = {}
    for r = 1, size do
        for c = 1, size do
            local sk = cellKey(r, c)
            if free[sk] and not seen[sk] then
                local q = {{r, c}}
                seen[sk] = true
                local qi = 1
                local hasEndpoint = false
                while qi <= #q do
                    local cr, cc = q[qi][1], q[qi][2]
                    qi += 1
                    local ck = cellKey(cr, cc)
                    if endpointKeys[ck] and not solvedSet[endpointKeys[ck]] then
                        hasEndpoint = true
                    end
                    for _, d in ipairs(DIRS4) do
                        local nr, nc = cr + d[1], cc + d[2]
                        if cells[nr] and cells[nr][nc] then
                            local nk = cellKey(nr, nc)
                            if free[nk] and not seen[nk] then
                                seen[nk] = true
                                q[#q + 1] = {nr, nc}
                            end
                        end
                    end
                end
                if not hasEndpoint then return false end
            end
        end
    end

    for _, p in ipairs(pairList) do
        if not solvedSet[p.num] then
            local blocked = {}
            for k in pairs(occupied) do blocked[k] = true end
            for k, num in pairs(endpointKeys) do
                if num ~= p.num then blocked[k] = true end
            end
            if not reachable(cells, size, p.a, p.b, blocked) then return false end
        end
    end
    return true
end

local function getCandidates(cells, size, pair, solvedSet, occupied, endpointKeys, deadline, maxPaths)
    local blocked = {}
    for k in pairs(occupied) do blocked[k] = true end
    for k, num in pairs(endpointKeys) do
        if num ~= pair.num then blocked[k] = true end
    end
    return collectPaths(cells, size, pair.a, pair.b, blocked, maxPaths or 220, deadline)
end

local function planAllPaths(cells, size, pairList)
    if #pairList == 0 then return {} end
    local endpointKeys = makeEndpointMap(pairList)
    local occupied = {}
    local solvedSet = {}
    local solution = {}
    local totalCells = 0
    for r = 1, size do
        for c = 1, size do
            if cells[r] and cells[r][c] then totalCells += 1 end
        end
    end

    local deadline = os.clock() + 2.5
    local nodes = 0

    local function apply(path)
        for _, node in ipairs(path) do
            occupied[cellKey(node.row, node.col)] = true
        end
    end
    local function undo(path)
        for _, node in ipairs(path) do
            occupied[cellKey(node.row, node.col)] = nil
        end
    end

    local function choosePair()
        local best, bestCandidates, bestCount = nil, nil, math.huge
        for _, p in ipairs(pairList) do
            if not solvedSet[p.num] then
                local candidates = getCandidates(cells, size, p, solvedSet, occupied, endpointKeys, deadline, 36)
                local count = #candidates
                if count == 0 then return p, {} end
                if count < bestCount then
                    best, bestCandidates, bestCount = p, candidates, count
                    if count == 1 then break end
                end
            end
        end
        return best, bestCandidates
    end

    local function search(depth)
        nodes += 1
        if nodes % 24 == 0 then task.wait() end
        if os.clock() > deadline then return false end
        if depth > #pairList then
            local used = 0
            for _ in pairs(occupied) do used += 1 end
            return used == totalCells
        end

        local pair, candidates = choosePair()
        if not pair or not candidates or #candidates == 0 then return false end

        for _, path in ipairs(candidates) do
            if os.clock() > deadline then return false end
            apply(path)
            solvedSet[pair.num] = true
            solution[depth] = {num = pair.num, path = path}

            if freeSpaceFeasible(cells, size, pairList, solvedSet, occupied, endpointKeys) then
                if search(depth + 1) then return true end
            end

            solution[depth] = nil
            solvedSet[pair.num] = nil
            undo(path)
        end
        return false
    end

    if not search(1) then return nil end

    local used = 0
    for _ in pairs(occupied) do used += 1 end
    if used ~= totalCells then return nil end

    local ordered = {}
    for i = 1, #solution do
        ordered[#ordered + 1] = solution[i].path
    end
    return ordered
end

local function verifyPlannedPaths(cells, size, pairList, planned)
    if not planned or #planned ~= #pairList then return false end
    local occupied = {}
    local endpoints = makeEndpointMap(pairList)
    local pairByNum = {}
    local total = 0
    for r = 1, size do
        for c = 1, size do
            if cells[r] and cells[r][c] then total += 1 end
        end
    end
    for _, pair in ipairs(pairList) do
        pairByNum[pair.num] = pair
    end

    for _, path in ipairs(planned) do
        if not path or #path < 2 then return false end
        local firstKey = cellKey(path[1].row, path[1].col)
        local lastKey = cellKey(path[#path].row, path[#path].col)
        local numA = endpoints[firstKey]
        local numB = endpoints[lastKey]
        if not numA or numA ~= numB or not pairByNum[numA] then return false end
        local pair = pairByNum[numA]
        local aKey = cellKey(pair.a.row, pair.a.col)
        local bKey = cellKey(pair.b.row, pair.b.col)
        if not ((firstKey == aKey and lastKey == bKey) or (firstKey == bKey and lastKey == aKey)) then
            return false
        end

        for j, node in ipairs(path) do
            local k = cellKey(node.row, node.col)
            if occupied[k] then return false end
            occupied[k] = numA
            if j > 1 then
                local prev = path[j - 1]
                if math.abs(node.row - prev.row) + math.abs(node.col - prev.col) ~= 1 then return false end
            end
            local endpointNum = endpoints[k]
            if endpointNum and endpointNum ~= numA then return false end
        end
    end

    local used = 0
    for _ in pairs(occupied) do used += 1 end
    return used == total
end

local function dragAlongPath(cells, path)
    if not path or #path < 2 then return false end
    local first = cells[path[1].row] and cells[path[1].row][path[1].col]
    if not first then return false end
    local x0, y0 = cellCenter(first)
    mouseDown(x0, y0)
    task.wait(0.02)
    for i = 2, #path do
        local cell = cells[path[i].row] and cells[path[i].row][path[i].col]
        if cell then
            local x, y = cellCenter(cell)
            mouseMove(x, y)
            task.wait(0.012)
        end
    end
    local last = path[#path]
    local lastCell = cells[last.row] and cells[last.row][last.col]
    if lastCell then
        local x1, y1 = cellCenter(lastCell)
        mouseUp(x1, y1)
    else
        mouseUp(x0, y0)
    end
    task.wait(0.05)
    return true
end

local solveBusy = false
local function solveNumberlinkOnce()
    if solveBusy then return false end
    solveBusy = true
    local success = false
    local ok = pcall(function()
        local grid = findPuzzleGrid()
        if not grid or not grid.Visible then return end
        local cells, pairsMap, size = parsePuzzleGrid(grid)
        if size < 2 then return end

        local pairList = {}
        local totalCells = 0
        for r = 1, size do
            for c = 1, size do
                if cells[r] and cells[r][c] then totalCells += 1 end
            end
        end

        for num, ends in pairs(pairsMap) do
            if #ends == 2 then
                table.insert(pairList, {num = num, a = ends[1], b = ends[2]})
            end
        end
        if #pairList == 0 or totalCells == 0 then return end

        for _, p in ipairs(pairList) do
            p.dist = math.abs(p.a.row - p.b.row) + math.abs(p.a.col - p.b.col)
        end

        local planned = planAllPaths(cells, size, pairList)
        if not verifyPlannedPaths(cells, size, pairList, planned) then return end

        for _, path in ipairs(planned) do
            if not states.autoSolveGen and not states.botEnabled then return end
            local done = dragAlongPath(cells, path)
            if not done then return end
            task.wait(0.05)
        end

        task.wait(0.15)
        success = true
    end)
    solveBusy = false
    return ok and success
end

local function checkAndSolveGenUI(force)
    if (not states.autoSolveGen and not force) or isSolvingGen or solveBusy then return false end
    isSolvingGen = true
    local ok, result = pcall(function()
        return solveNumberlinkOnce()
    end)
    isSolvingGen = false
    return ok and result
end

local function moveToPoint(hum, hrp, targetPosition, timeout, activeCheck, arriveDist)
    arriveDist = arriveDist or 3.2
    local reached = false
    local conn
    conn = hum.MoveToFinished:Connect(function(ok)
        reached = ok
    end)
    hum:MoveTo(targetPosition)
    local started = os.clock()
    while activeCheck() and os.clock() - started < (timeout or 1.1) do
        if (hrp.Position - targetPosition).Magnitude <= arriveDist then
            reached = true
            break
        end
        if reached then break end
        task.wait(0.03)
    end
    if conn then conn:Disconnect() end
    return reached
end

local function followPath(hum, hrp, fromPos, toPos, activeCheck, opts)
    opts = opts or {}
    local smooth = opts.smooth == true
    local stopDist = opts.stopDist or 7

    local offsets = {
        Vector3.zero,
        Vector3.new(3.5, 0, 0), Vector3.new(-3.5, 0, 0),
        Vector3.new(0, 0, 3.5), Vector3.new(0, 0, -3.5),
        Vector3.new(2.5, 0, 2.5), Vector3.new(-2.5, 0, 2.5),
        Vector3.new(2.5, 0, -2.5), Vector3.new(-2.5, 0, -2.5),
        Vector3.new(5, 0, 0), Vector3.new(-5, 0, 0),
        Vector3.new(0, 0, 5), Vector3.new(0, 0, -5),
    }
    if opts.noOffset then
        offsets = { Vector3.zero }
    end

    local radii = { 1.2, 1.6, 2.2 }
    local waypoints = nil
    local usedGoal = toPos

    for _, radius in ipairs(radii) do
        if waypoints then break end
        for _, off in ipairs(offsets) do
            if not activeCheck() then return false end
            local goal = toPos + off
            local path = PathfindingService:CreatePath({
                AgentRadius = radius,
                AgentHeight = 5,
                AgentCanJump = true,
                AgentJumpHeight = 14,
                WaypointSpacing = smooth and 3.2 or 2.0,
            })
            local ok = pcall(function()
                path:ComputeAsync(fromPos, goal)
            end)
            if ok and path.Status == Enum.PathStatus.Success then
                waypoints = path:GetWaypoints()
                usedGoal = goal
                break
            end
        end
    end

    if not waypoints or #waypoints == 0 then
        hum:MoveTo(toPos)
        local t0 = os.clock()
        while activeCheck() and os.clock() - t0 < 1.2 do
            if (hrp.Position - toPos).Magnitude <= stopDist then return true end
            if hum.FloorMaterial == Enum.Material.Air then
                hum.Jump = true
            end
            task.wait(0.08)
        end
        return (hrp.Position - toPos).Magnitude <= stopDist + 2
    end

    for i, waypoint in ipairs(waypoints) do
        if not activeCheck() then return false end
        if states.botSprint then
            hum.WalkSpeed = getSprintSpeed()
            setShiftHeld(true)
        end
        if waypoint.Action == Enum.PathWaypointAction.Jump then
            hum.Jump = true
        end
        local arrive = smooth and 5.5 or 2.8
        local timeout = smooth and 0.55 or 0.9
        if smooth and i < #waypoints then
            hum:MoveTo(waypoint.Position)
            local t0 = os.clock()
            while activeCheck() and os.clock() - t0 < timeout do
                local d = (hrp.Position - waypoint.Position).Magnitude
                if d <= arrive then break end
                if (hrp.Position - usedGoal).Magnitude <= stopDist then return true end
                task.wait(0.03)
            end
        else
            moveToPoint(hum, hrp, waypoint.Position, timeout, activeCheck, arrive)
        end
        if (hrp.Position - toPos).Magnitude <= stopDist then
            return true
        end
        if i % 8 == 0 and (hrp.Position - waypoint.Position).Magnitude > 10 then
            return followPath(hum, hrp, hrp.Position, toPos, activeCheck, opts)
        end
    end
    return true
end

