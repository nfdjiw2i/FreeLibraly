local backWeld = nil

local function updateBackSeat()
    local myChar = LP.Character
    if not myChar then return end
    local myHrp = myChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar:FindFirstChildOfClass("Humanoid")
    
    if states.backTeleport then
        local targetChar = getGuest666Killer()
        if targetChar and myHrp and myHum then
            local targetTorso = targetChar:FindFirstChild("UpperTorso") 
                or targetChar:FindFirstChild("Torso") 
                or targetChar:FindFirstChild("HumanoidRootPart")
            
            if targetTorso then
                if not backWeld or backWeld.Parent ~= myHrp or backWeld.Part1 ~= targetTorso then
                    if backWeld then backWeld:Destroy() end
                    myHrp.CFrame = targetTorso.CFrame * CFrame.new(0, -0.2, 1.2) * CFrame.Angles(0, math.pi, 0)
                    
                    backWeld = Instance.new("Weld")
                    backWeld.Name = "Guest666BackSeatWeld"
                    backWeld.Part0 = myHrp
                    backWeld.Part1 = targetTorso
                    backWeld.C0 = CFrame.new(0, -0.2, 1.2) * CFrame.Angles(0, math.pi, 0)
                    backWeld.Parent = myHrp
                end
                
                myHum.Sit = true
                myHum.Jump = false
                myHrp.AssemblyLinearVelocity = Vector3.zero
                myHrp.AssemblyAngularVelocity = Vector3.zero
            end
        end
    else
        if backWeld then
            backWeld:Destroy()
            backWeld = nil
        end
        if myHum then
            myHum.Sit = false
        end
    end
end

local currentPlayingAnimTrack = nil

local function playCustomAnimation(animId)
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)
    
    local cleanId = tostring(animId):gsub("%D", "")
    if cleanId == "" then return end
    
    if currentPlayingAnimTrack then
        currentPlayingAnimTrack:Stop()
        currentPlayingAnimTrack = nil
    end
    
    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://" .. cleanId
    
    local ok, track = pcall(function()
        return animator:LoadAnimation(anim)
    end)
    
    if ok and track then
        currentPlayingAnimTrack = track
        track:Play()
    end
end

