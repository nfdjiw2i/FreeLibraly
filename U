end

local function getGeneratorProgress(gen)
    if not gen or not gen.Parent then return 100 end
    local best = nil

    local function consider(v)
        if typeof(v) ~= "number" then return end
        local p = v
        if p <= 1.05 and p >= 0 then
            p = p * 100
        end
        if p < 0 then return end
        if p > 100 then p = 100 end
        if best == nil or p > best then best = p end
    end

    for _, a in ipairs({"Progress", "RepairProgress", "Percent", "Completion", "Progression", "Charge", "Power", "Amount"}) do
        consider(gen:GetAttribute(a))
    end

    pcall(function()
        for _, d in ipairs(gen:GetDescendants()) do
            if d:IsA("NumberValue") or d:IsA("IntValue") or d:IsA("DoubleConstrainedValue") then
                local n = d.Name:lower()
                if n:find("progress", 1, true) or n:find("percent", 1, true)
                    or n:find("repair", 1, true) or n:find("charge", 1, true)
                    or n:find("completion", 1, true) or n == "value" then
                    consider(d.Value)
                end
            elseif d:IsA("TextLabel") or d:IsA("TextButton") then
                local t = tostring(d.Text or "")
                local pct = tonumber(string.match(t, "(%d+)%s*%%"))
                if pct then consider(pct) end
            elseif d:IsA("GuiObject") then
                local n = d.Name:lower()
                if (n:find("fill", 1, true) or n:find("bar", 1, true) or n:find("progress", 1, true))
                    and d.Size and d.Size.X then
                    local scale = d.Size.X.Scale
                    if scale and scale > 0 and scale <= 1.05 then
                        consider(scale * 100)
                    end
                end
            end
        end
    end)

    return best or 0
end

local function isGeneratorCompleted(gen)
    if not gen or not gen.Parent then return true end
    if completedGenBlacklist[gen] and (os.clock() - completedGenBlacklist[gen]) < GEN_BLACKLIST_SEC then
        return true
    end
    local pk = genPosKey(gen)
    if pk and completedGenPosKeys[pk] and (os.clock() - completedGenPosKeys[pk]) < GEN_BLACKLIST_SEC then
        return true
    end

    local progress = getGeneratorProgress(gen)
    if progress > 99 then
        return true
    end

    for _, a in ipairs({"Completed", "Complete", "Done", "Finished", "Repaired", "IsCompleted", "Fixed", "IsFixed"}) do
        local v = gen:GetAttribute(a)
        if v == true or v == 1 then return true end
    end

    return false
end

local function isGeneratorUsable(gen)
    if not gen or not gen.Parent then return false end
    if isGeneratorCompleted(gen) then return false end
    if lastWorkedGen == gen and (os.clock() - lastWorkedAt) < 10 then
        return false
    end
    return true
end

local function markGeneratorDone(gen)
    if not gen then return end
    completedGenBlacklist[gen] = os.clock()
    local pk = genPosKey(gen)
    if pk then completedGenPosKeys[pk] = os.clock() end
    lastWorkedGen = gen
    lastWorkedAt = os.clock()
end

local function getIngameGenerators()
    local now = os.clock()
    if now - genCacheAt < 4.0 and #genCache > 0 then
        local alive = {}
        for _, g in ipairs(genCache) do
            if g and g.Parent then table.insert(alive, g) end
        end
        genCache = alive
        if #genCache > 0 then return genCache end
    end
    genCacheAt = now
    local gens = {}
    local seen = {}
    local function addGen(obj)
        if not obj or seen[obj] then return end
        if obj:IsA("BasePart") then
            local m = obj:FindFirstAncestorOfClass("Model")
            if m and m.Name:lower():find("gen", 1, true) then
                obj = m
            end
        end
        if seen[obj] then return end
        seen[obj] = true
        table.insert(gens, obj)
    end
    local roots = {}
    local mapFolder = workspace:FindFirstChild("Map")
    if mapFolder then
        table.insert(roots, mapFolder)
        local ingame = mapFolder:FindFirstChild("Ingame")
        if ingame then
            table.insert(roots, ingame)
            local im = ingame:FindFirstChild("Map")
            if im then table.insert(roots, im) end
        end
    end
    for _, n in ipairs({"Generators", "Objectives", "Ingame"}) do
        local f = workspace:FindFirstChild(n)
        if f then table.insert(roots, f) end
    end
    if #roots == 0 then
        table.insert(roots, workspace)
    end
    for _, root in ipairs(roots) do
        pcall(function()
            for _, obj in ipairs(root:GetDescendants()) do
                if obj:IsA("Model") then
                    local oName = obj.Name:lower()
                    if oName:find("generator", 1, true)
                        or (oName == "gen")
                        or (oName:find("gen", 1, true) and not oName:find("gender", 1, true)
                            and not oName:find("agent", 1, true) and not oName:find("regen", 1, true)) then
                        addGen(obj)
                    end
                end
            end
        end)
        if #gens >= 12 then break end
    end
    genCache = gens
    genCacheAt = os.clock()
    return gens
end

