local function recordLobbyPosition()
    local root = getRootPart()
    if not root then return end
    local now = os.clock()
    lobbyHistory[#lobbyHistory + 1] = {t = now, cf = root.CFrame}
    local cutoff = now - lobbyHistoryMax
    local first = 1
    while lobbyHistory[first] and lobbyHistory[first].t < cutoff do first += 1 end
    if first > 1 then
        local compact = {}
        for i = first, #lobbyHistory do compact[#compact + 1] = lobbyHistory[i] end
        lobbyHistory = compact
    end
end

local function getPastLobbyCFrame(secondsBack)
    local now = os.clock()
    local targetTime = now - math.clamp(secondsBack or 0.5, 0.1, lobbyHistoryMax)
    local best = nil
    for i = #lobbyHistory, 1, -1 do
        local sample = lobbyHistory[i]
        if sample.t <= targetTime then
            best = sample.cf
            break
        end
    end
    if not best and lobbyHistory[1] then best = lobbyHistory[1].cf end
    return best
end

local function lobbySafeTeleport(secondsBack)
    local cf = getPastLobbyCFrame(secondsBack)
    if not cf then return false end
    safeTeleport(cf)
    return true
end

safeTeleport = function(targetCFrame)
    local myChar = LP.Character
    if not myChar then return end
    local hrp = myChar:FindFirstChild("HumanoidRootPart")
    local hum = myChar:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    if states.safeSpectatorTp then
        hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
        for _, part in ipairs(myChar:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanTouch = false
                part.Velocity = Vector3.zero
                part.RotVelocity = Vector3.zero
            end
        end
    end

    hrp.CFrame = targetCFrame

    if states.safeSpectatorTp then
        task.delay(1.5, function()
            if myChar and myChar.Parent then
                for _, part in ipairs(myChar:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanTouch = true
                    end
                end
                if hum and hum.Parent then
                    hum:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
                end
            end
        end)
    end
end

