                if desc and desc.Parent then
                    if desc:GetAttribute("OrigCanCollide") == nil then
                        desc:SetAttribute("OrigCanCollide", desc.CanCollide)
                    end
                    desc.CanCollide = false
                end
            end
        end
    else
        for _, desc in ipairs(killerDoorCache) do
            if desc and desc.Parent and desc:GetAttribute("OrigCanCollide") ~= nil then
                desc.CanCollide = desc:GetAttribute("OrigCanCollide")
                desc:SetAttribute("OrigCanCollide", nil)
            end
        end
        killerDoorCache = {}
        killerDoorMap = {}
    end
end

local function isLikelyFloor(part)
    local s = part.Size
    if s.Y <= 3 and (s.X >= 12 or s.Z >= 12) then return true end
    if s.Y <= 2 and s.X * s.Z >= 40 then return true end
    local n = part.Name:lower()
    if n:find("floor", 1, true) or n:find("ground", 1, true) or n:find("baseplate", 1, true)
        or n:find("terrain", 1, true) or n:find("ceiling", 1, true) then
        return true
    end
    return false
end

local function updateBarriers()
    if states.noBarriers then
        for _, desc in ipairs(workspace:GetDescendants()) do
            if desc:IsA("BasePart") and not isLikelyFloor(desc) then
                local lname = desc.Name:lower()
                local isBarrierName = lname:find("barrier", 1, true)
                    or lname:find("invisiblewall", 1, true)
                    or lname:find("anti", 1, true)
                    or lname:find("blocker", 1, true)
                    or lname:find("nocollide", 1, true)
                    or (lname:find("clip", 1, true) and not lname:find("script", 1, true))
                if isBarrierName and desc.CanCollide then
                    if barrierOriginalState[desc] == nil then
                        barrierOriginalState[desc] = true
                    end
                    desc.CanCollide = false
                end
            end
        end
    else
        for part, origState in pairs(barrierOriginalState) do
            if part and part.Parent then
                part.CanCollide = origState
            end
        end
        barrierOriginalState = {}
    end
end

