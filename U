local function firePrompt(prompt)
    if not prompt then return false end
    local holdTime = math.max(tonumber(prompt.HoldDuration) or 0, 0.35)

    if typeof(fireproximityprompt) == "function" then
        local ok = pcall(function()
            fireproximityprompt(prompt)
        end)
        if ok then
            task.wait(0.15)
            return true
        end
        ok = pcall(function()
            fireproximityprompt(prompt, holdTime)
        end)
        if ok then return true end
    end

    local ok = pcall(function()
        prompt:InputHoldBegin()
        task.wait(holdTime + 0.12)
        prompt:InputHoldEnd()
    end)
    return ok
end

local function getNearestPrompt(fromPos, root)
    local best, bestD = nil, math.huge
    local list = {}
    if root then
        for _, o in ipairs(root:GetDescendants()) do
            if o:IsA("ProximityPrompt") then table.insert(list, o) end
        end
    else
        for _, o in ipairs(workspace:GetDescendants()) do
            if o:IsA("ProximityPrompt") and o.Enabled then
                local p = o.Parent
                if p and p:IsA("BasePart") then
                    local d = (fromPos - p.Position).Magnitude
                    if d < 18 then table.insert(list, o) end
                end
            end
        end
    end
    for _, o in ipairs(list) do
        if o.Enabled or o.Enabled == nil then
            local part = o.Parent
            local pos = part and part:IsA("BasePart") and part.Position
            if pos then
                local d = (fromPos - pos).Magnitude
                if d < bestD then
                    bestD = d
                    best = o
                end
            end
        end
    end
    return best, bestD
end

local function autoFixGenerator(targetGenerator)
    local gens = getIngameGenerators()
    local myChar = LP.Character
    local hrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local hum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    if not hrp then return false end

    local closestGen = targetGenerator
    local minDist = math.huge
    if not closestGen then
        for _, gen in ipairs(gens) do
            local pos = gen:IsA("Model") and gen:GetPivot().Position or gen.Position
            local dist = (hrp.Position - pos).Magnitude
            if dist < minDist then
                minDist = dist
                closestGen = gen
            end
        end
    else
        local pos = closestGen:IsA("Model") and closestGen:GetPivot().Position or closestGen.Position
        minDist = (hrp.Position - pos).Magnitude
    end

    if not closestGen then return false end

    local prompt, pDist = getNearestPrompt(hrp.Position, closestGen)
    if not prompt then
        prompt, pDist = getNearestPrompt(hrp.Position, nil)
    end

    if prompt and prompt.Parent and prompt.Parent:IsA("BasePart") and hum then
        local part = prompt.Parent
        local maxDist = (prompt.MaxActivationDistance or 10) * 0.85
        if (hrp.Position - part.Position).Magnitude > math.min(maxDist, 4) then
            hum:MoveTo(part.Position)
            local t0 = os.clock()
            while os.clock() - t0 < 2.0 and (hrp.Position - part.Position).Magnitude > 3.0 do
                task.wait(0.05)
            end
        end
    end

    if prompt then
        return firePrompt(prompt)
    end
    return false
end

