local function getGuest666Killer()
    local guestKillerChar = nil
    local anyKillerChar = nil

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            local role = getPlayerRoleFolder(p)
            if role == "Killers" and p.Character then
                local char = p.Character
                local nameLower = string.lower(p.Name .. " " .. p.DisplayName .. " " .. char.Name)
                if nameLower:find("666") or nameLower:find("guest") then
                    guestKillerChar = char
                    break
                else
                    anyKillerChar = char
                end
            end
        end
    end
    return guestKillerChar or anyKillerChar
