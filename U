local function isKillerDoorPart(desc)
    if not desc:IsA("BasePart") then return false end
    local lname = desc.Name:lower()
    local pname = desc.Parent and desc.Parent.Name:lower() or ""
    local gname = desc.Parent and desc.Parent.Parent and desc.Parent.Parent.Name:lower() or ""
    if lname:find("killerdoor", 1, true) or lname:find("killer_door", 1, true) then return true end
    if pname:find("killerdoor", 1, true) or pname:find("killer_door", 1, true) then return true end
    if lname:find("killer", 1, true) and lname:find("door", 1, true) then return true end
    if pname:find("killer", 1, true) and (lname:find("door", 1, true) or pname:find("door", 1, true)) then return true end
    if gname:find("killer", 1, true) and lname:find("door", 1, true) then return true end
    if (lname == "door" or lname == "gate" or lname == "slide") and (pname:find("killer", 1, true) or gname:find("killer", 1, true)) then
        return true
    end
    return false
end

