local function CollapseParticles(center,outward)
	for i=1,16 do
		local a=((i-1)/16)*math.pi*2
		local s=math.random(2,5)
		local p=New("Frame",{Size=UDim2.fromOffset(s,s),Position=UDim2.fromOffset(center.X-s/2,center.Y-s/2),BackgroundColor3=C.White,BackgroundTransparency=.05,BorderSizePixel=0,ZIndex=700},Gui)
		local d=outward and math.random(90,180) or math.random(18,42)
		Tween(p,{Position=UDim2.fromOffset(center.X+math.cos(a)*d-s/2,center.Y+math.sin(a)*d-s/2),Size=UDim2.fromOffset(1,1),BackgroundTransparency=1},.35)
		task.delay(.4,function()if p.Parent then p:Destroy()end end)
	end
end

local function CreateCollapseCube(pos)
	if CollapseCube and CollapseCube.Parent then CollapseCube:Destroy()end
	local b=New("TextButton",{Size=UDim2.fromOffset(38,38),Position=pos or SavedCubePosition or UDim2.fromOffset(MenuCenter().X,MenuCenter().Y),AnchorPoint=Vector2.new(.5,.5),BackgroundColor3=C.Black,BorderSizePixel=0,Text="[+]",TextColor3=C.White,TextSize=10,Font=Enum.Font.Code,AutoButtonColor=false,ZIndex=800},Gui)
	Stroke(b,C.White,1,0);CornerMarks(b,7,1,C.White,805)
	b.InputBegan:Connect(function(i)if i.UserInputType==Enum.UserInputType.MouseButton1 then CollapseCubeDragging=true;CubeDragMoved=false;CubeDragStart=i.Position;CubeStartPosition=b.Position end end)
	b.InputEnded:Connect(function(i)if i.UserInputType==Enum.UserInputType.MouseButton1 then CollapseCubeDragging=false;if not CubeDragMoved and Minimized then Library:Show()end end end)
	CollapseCube=b
	return b
end

function Library:Show()
	if Destroying then return end
	Minimized=false;MenuOpen=true;Gui.Enabled=true
