local function GetPageCanvas(page)
	local columns=page:FindFirstChild("Columns")
	if not columns then return 0 end
	local left=columns:FindFirstChild("LeftColumn")
	local right=columns:FindFirstChild("RightColumn")
	local lh=left and left.AbsoluteSize.Y or 0
	local rh=right and right.AbsoluteSize.Y or 0
	return math.max(lh,rh)+20
end

local function UpdatePageCanvas(page)
	if not page or not page.Parent then return end
	local columns=page:FindFirstChild("Columns")
	if columns then page.CanvasSize=UDim2.fromOffset(0,GetPageCanvas(page)) end
end

local function CreatePage(name)
	local page=New("ScrollingFrame",{
		Name=name,
		Size=UDim2.new(1,-56,1,-92),
		Position=UDim2.new(0,28,0,82),
		BackgroundTransparency=1,
		BorderSizePixel=0,
		ScrollBarThickness=2,
		ScrollBarImageColor3=C.White,
		ScrollBarImageTransparency=.45,
		CanvasSize=UDim2.fromOffset(0,0),
		ScrollingDirection=Enum.ScrollingDirection.Y,
		Visible=false,
		ZIndex=28,
		ClipsDescendants=true
	},Content)
	local columns=New("Frame",{Name="Columns",Size=UDim2.new(1,-20,1,0),Position=UDim2.new(0,10,0,0),BackgroundTransparency=1,BorderSizePixel=0},page)
	local left=New("Frame",{Name="LeftColumn",Size=UDim2.new(.5,-16,0,0),Position=UDim2.new(0,4,0,0),BackgroundTransparency=1,BorderSizePixel=0},columns)
	local right=New("Frame",{Name="RightColumn",Size=UDim2.new(.5,-16,0,0),Position=UDim2.new(.5,12,0,0),BackgroundTransparency=1,BorderSizePixel=0},columns)
	for _,column in ipairs({left,right}) do
		local layout=New("UIListLayout",{Padding=UDim.new(0,10),SortOrder=Enum.SortOrder.LayoutOrder},column)
		layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
			column.Size=UDim2.new(column.Size.X.Scale,column.Size.X.Offset,0,layout.AbsoluteContentSize.Y)
			UpdatePageCanvas(page)
		end)
	end
	Pages[name]=page
	return page
end

local function ActivateTab(name)
	if not Tabs[name] then return end
	CurrentTab=name
	for n,d in pairs(Tabs) do
		local active=n==name
		d.Page.Visible=active
		d.Button.BackgroundColor3=C.Black
		d.Text.TextColor3=active and C.White or C.Gray
		d.Outer.Enabled=active
		d.Inner.Enabled=active
		if d.Corners then for _,c in ipairs(d.Corners) do c.Visible=active end end
		if d.Icon then d.Icon.Visible=Library.Config.ShowIcons end
	end
	ContentTitle.Text=name
	ContentSubtitle.Text="// "..string.upper(name).." FUNCTIONS"
	CurrentTabObject=Tabs[name].Object
	CurrentSectionObject=nil
end

local function RebuildTabs()
