local function New(class,props,parent)
	local o=Instance.new(class)
	for k,v in pairs(props or {}) do
		pcall(function() o[k]=v end)
	end
	if o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox") then
		pcall(function() o.AutoLocalize=false end)
		pcall(function() o.AutoButtonColor=false end)
	end
	o.Parent=parent
	return o
end

local function Label(parent,text,size,color)
	return New("TextLabel",{
		BackgroundTransparency=1,
		Text=tostring(text or ""),
		TextSize=size or 11,
		TextColor3=color or C.White,
		Font=Enum.Font.Code,
		TextXAlignment=Enum.TextXAlignment.Left,
		TextYAlignment=Enum.TextYAlignment.Center,
		RichText=false,
		TextWrapped=false
	},parent)
end

local function Stroke(obj,color,thickness,transparency)
	local s=Instance.new("UIStroke")
	s.Color=color or C.Line
	s.Thickness=thickness or 1
	s.Transparency=transparency or 0
	s.ApplyStrokeMode=Enum.ApplyStrokeMode.Border
	s.Parent=obj
	return s
end

local function Corner(obj,radius)
	local c=Instance.new("UICorner")
	c.CornerRadius=UDim.new(0,radius or 0)
	c.Parent=obj
	return c
end

local function Tween(obj,props,time,style,direction)
	if not obj or not obj.Parent then return end
	local t=TweenService:Create(obj,TweenInfo.new(time or .18,style or Enum.EasingStyle.Quart,direction or Enum.EasingDirection.Out),props)
	t:Play()
	return t
end

local function DisableLocalization(root)
	if not root then return end
	for _,o in ipairs(root:GetDescendants()) do
		if o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox") then
			pcall(function() o.AutoLocalize=false end)
		end
	end
end

local function AddGrid(parent,alpha)
	local g=New("Frame",{Size=UDim2.fromScale(1,1),BackgroundTransparency=1,ClipsDescendants=true,ZIndex=(parent.ZIndex or 1)+1},parent)
	for i=0,16 do
		New("Frame",{Size=UDim2.new(1,0,0,1),Position=UDim2.new(0,0,i/16,0),BackgroundColor3=C.White,BackgroundTransparency=alpha or .994,BorderSizePixel=0,ZIndex=g.ZIndex},g)
	end
	for i=0,16 do
		New("Frame",{Size=UDim2.new(0,1,1,0),Position=UDim2.new(i/16,0,0,0),BackgroundColor3=C.White,BackgroundTransparency=alpha or .996,BorderSizePixel=0,ZIndex=g.ZIndex},g)
	end
	return g
end

local function CornerMarks(parent,size,thickness,color,z)
	size=size or 10
	thickness=thickness or 1
	color=color or C.White
	z=z or ((parent.ZIndex or 1)+3)
	local marks={
		{UDim2.new(0,0,0,0),UDim2.fromOffset(size,thickness)},
		{UDim2.new(1,-size,0,0),UDim2.fromOffset(size,thickness)},
		{UDim2.new(0,0,1,-thickness),UDim2.fromOffset(size,thickness)},
		{UDim2.new(1,-size,1,-thickness),UDim2.fromOffset(size,thickness)},
		{UDim2.new(0,0,0,0),UDim2.fromOffset(thickness,size)},
		{UDim2.new(1,-thickness,0,0),UDim2.fromOffset(thickness,size)},
		{UDim2.new(0,0,1-size),UDim2.fromOffset(thickness,size)},
		{UDim2.new(1,-thickness,1-size),UDim2.fromOffset(thickness,size)}
	}
	for _,m in ipairs(marks) do New("Frame",{Size=m[2],Position=m[1],BackgroundColor3=color,BorderSizePixel=0,ZIndex=z},parent) end
end

local function TimeData()
	local n=os.date("*t")
	local state=(Lighting.ClockTime>=6 and Lighting.ClockTime<18) and "DAY" or "NIGHT"
	return string.format("%02d:%02d:%02d",n.hour,n.min,n.sec),state,string.format("%02d.%02d.%04d",n.day,n.month,n.year)
end

