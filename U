		LoadFill.Size=UDim2.new(i/100,0,1,0)
		if i<25 then SplashStatus.Text="INITIALIZING // "..string.format("%02d",i).."%" elseif i<55 then SplashStatus.Text="BUILDING CORE // "..string.format("%02d",i).."%" elseif i<85 then SplashStatus.Text="BUILDING UI // "..string.format("%02d",i).."%" else SplashStatus.Text="READY // "..string.format("%02d",i).."%" end
