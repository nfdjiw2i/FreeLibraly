local function buildConfig()
    return {version = 2, states = states, values = {tpSpeed = tpSpeedValue, shiftTpSpeed = shiftTpSpeedValue, walkSpeed = walkSpeedValue, jumpPower = jumpPowerValue, flySpeed = flySpeedValue, sprintSpeed = sprintSpeedValue, lobbySafeDelay = lobbySafeDelay}}
