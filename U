local function RebuildElements(section)
	if not section or not section.Elements then return end
	for i,e in ipairs(section.Elements) do
		if e and e.Frame and e.Frame.Parent then
			e.Frame.LayoutOrder=i
		end
	end
	if section.RefreshLayout then
		section:RefreshLayout()
	end
end

local function MakeDragHandle(frame,element)
	if not Library.Config.AllowReorder then return end
	local h=New("TextButton",{Size=UDim2.fromOffset(14,20),Position=UDim2.new(0,3,.5,-10),BackgroundTransparency=1,Text="",AutoButtonColor=false,ZIndex=90},frame)
	local line1=New("Frame",{Size=UDim2.fromOffset(3,1),Position=UDim2.new(0,2,0,6),BackgroundColor3=C.Gray2,BorderSizePixel=0,ZIndex=91},h)
	local line2=New("Frame",{Size=UDim2.fromOffset(3,1),Position=UDim2.new(0,2,0,10),BackgroundColor3=C.Gray2,BorderSizePixel=0,ZIndex=91},h)
	local line3=New("Frame",{Size=UDim2.fromOffset(3,1),Position=UDim2.new(0,2,0,14),BackgroundColor3=C.Gray2,BorderSizePixel=0,ZIndex=91},h)
	local active=false
	local startY=0
	h.InputBegan:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.MouseButton1 then active=true;startY=i.Position.Y;frame.BackgroundColor3=C.Panel4 end
	end)
	UserInputService.InputChanged:Connect(function(i)
		if active and i.UserInputType==Enum.UserInputType.MouseMovement and math.abs(i.Position.Y-startY)>4 then element.Dragging=true end
	end)
	UserInputService.InputEnded:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.MouseButton1 and active then
			active=false
			if element.Dragging and element.Section then
				local center=frame.AbsolutePosition.Y+frame.AbsoluteSize.Y/2
				local current
				for n,e in ipairs(element.Section.Elements) do if e==element then current=n break end end
				if current then
					local target=#element.Section.Elements
					for n,e in ipairs(element.Section.Elements) do
						if e~=element and center<e.Frame.AbsolutePosition.Y+e.Frame.AbsoluteSize.Y/2 then target=n break end
					end
					table.remove(element.Section.Elements,current)
