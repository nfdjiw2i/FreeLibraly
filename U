local function initFirebaseStats()
    local userKey = tostring(LP.UserId)
    local endpoint = FIREBASE_URL .. "users/" .. userKey .. ".json"
    local initialMoney = getPlayerMoney()

    moneyStats.current = initialMoney
    moneyStats.previous = initialMoney
    moneyStats.startOfDay = initialMoney

    local remote = httpRequest(endpoint, "GET")
    if type(remote) == "table" then
        if type(remote.history) == "table" and #remote.history > 0 then
            moneyStats.history = remote.history
        end
        if remote.startOfDay then moneyStats.startOfDay = remote.startOfDay end
        if remote.todayEarned then moneyStats.earnedToday = remote.todayEarned end
        if remote.todaySpent then moneyStats.spentToday = remote.todaySpent end
        if remote.weekEarned then moneyStats.earnedWeek = remote.weekEarned end
        if remote.weekSpent then moneyStats.spentWeek = remote.weekSpent end
        if remote.totalEarned then moneyStats.earnedTotal = remote.totalEarned end
        if remote.totalSpent then moneyStats.spentTotal = remote.totalSpent end
        if remote.currentMoney then
            moneyStats.current = remote.currentMoney
            moneyStats.previous = remote.previousMoney or remote.currentMoney
        end
    end

    if #moneyStats.history == 0 then
        table.insert(moneyStats.history, {
            time = os.time(),
            date = os.date("%Y-%m-%d %H:%M:%S"),
            prevAmount = initialMoney,
            amount = initialMoney,
            diff = 0,
        })
    end

    task.spawn(function()
        httpRequest(endpoint, "PATCH", {
            username = LP.Name,
            lastOnline = os.time(),
            currentMoney = initialMoney,
            startOfDay = moneyStats.startOfDay,
            todayEarned = moneyStats.earnedToday,
            weekEarned = moneyStats.earnedWeek,
            totalEarned = moneyStats.earnedTotal,
            history = moneyStats.history,
        })
    end)

    task.spawn(function()
        local lastVal = getPlayerMoney()
        local lastPatch = 0
        while task.wait(12) do
            if not scriptAlive then break end
            local curVal = getPlayerMoney()
            if curVal ~= lastVal then
                local diff = curVal - lastVal
                moneyStats.previous = lastVal
                moneyStats.current = curVal
                if diff > 0 then
                    moneyStats.earnedToday += diff
                    moneyStats.earnedWeek += diff
                    moneyStats.earnedTotal += diff
                elseif diff < 0 then
                    local spent = -diff
                    moneyStats.spentToday += spent
                    moneyStats.spentWeek += spent
                    moneyStats.spentTotal += spent
                end

                table.insert(moneyStats.history, {
                    time = os.time(),
                    date = os.date("%Y-%m-%d %H:%M:%S"),
                    prevAmount = lastVal,
                    amount = curVal,
                    diff = diff,
                    kind = diff >= 0 and "earn" or "spend",
                })
                while #moneyStats.history > 40 do
                    table.remove(moneyStats.history, 1)
                end

                if os.clock() - lastPatch > 25 then
                    lastPatch = os.clock()
                    task.spawn(function()
                        httpRequest(endpoint, "PATCH", {
                            lastOnline = os.time(),
                            username = LP.Name,
                            currentMoney = curVal,
                            previousMoney = lastVal,
                            startOfDay = moneyStats.startOfDay,
                            todayEarned = moneyStats.earnedToday,
                            todaySpent = moneyStats.spentToday,
                            weekEarned = moneyStats.earnedWeek,
                            weekSpent = moneyStats.spentWeek,
                            totalEarned = moneyStats.earnedTotal,
                            totalSpent = moneyStats.spentTotal,
                            historyLen = #moneyStats.history,
                        })
                    end)
                end
                lastVal = curVal
            end
        end
    end)
end

