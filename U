local function RebalanceTabCategories(tab)
	if not tab or not tab.Sections then return end
	local page=tab.Page
	local columns=page and page:FindFirstChild("Columns")
	if not columns then return end
	local left=columns:FindFirstChild("LeftColumn")
	local right=columns:FindFirstChild("RightColumn")
	if not left or not right then return end

	for index,section in ipairs(tab.Sections) do
		local target
		if index%2==1 then
			target=left
		else
			target=right
		end
		if section.Frame then
			section.Frame.LayoutOrder=math.ceil(index/2)
			if section.Frame.Parent~=target then
				section.Frame.Parent=target
			end
		end
		section.Column=target
	end

	left.Size=UDim2.new(.5,-9,0,0)
	right.Size=UDim2.new(.5,-9,0,0)

	local ll=left:FindFirstChildOfClass("UIListLayout")
	local rl=right:FindFirstChildOfClass("UIListLayout")
	if ll then
		left.Size=UDim2.new(.5,-9,0,ll.AbsoluteContentSize.Y)
	end
	if rl then
		right.Size=UDim2.new(.5,-9,0,rl.AbsoluteContentSize.Y)
	end
	UpdatePageCanvas(page)
end

function SectionMethods:Reflow()
	if self.Category then UpdateCategory(self) end
	if self.Sections and self.Page and self.Page.Parent then
		local tab
		for _,name in ipairs(TabOrder) do
			local t=Tabs[name]
			if t and t.Object and t.Object.Sections==self.Sections then tab=t.Object break end
		end
		if tab then RebalanceTabCategories(tab) end
	end
	return self
end

