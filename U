local function applyConfig(data)
    if type(data) ~= "table" then return false end
    local src = type(data.states) == "table" and data.states or data
    for key, value in pairs(src) do
        if states[key] ~= nil and type(value) == "boolean" then states[key] = value end
    end
    local v = type(data.values) == "table" and data.values or data
    if type(v.tpSpeed) == "number" then tpSpeedValue = math.clamp(v.tpSpeed, 5, 100) end
    if type(v.shiftTpSpeed) == "number" then shiftTpSpeedValue = math.clamp(v.shiftTpSpeed, 10, 150) end
    if type(v.walkSpeed) == "number" then walkSpeedValue = math.clamp(v.walkSpeed, 16, 200) end
    if type(v.jumpPower) == "number" then jumpPowerValue = math.clamp(v.jumpPower, 50, 300) end
    if type(v.flySpeed) == "number" then flySpeedValue = math.clamp(v.flySpeed, 10, 300) end
    if type(v.sprintSpeed) == "number" then sprintSpeedValue = math.clamp(v.sprintSpeed, 20, 100) end
    if type(v.lobbySafeDelay) == "number" then lobbySafeDelay = math.clamp(v.lobbySafeDelay, 0.1, 0.5) end
    pcall(updateKillerDoors)
    pcall(updateBarriers)
    return true
end

