    valueLabel.TextColor3 = THEME.DIM
    valueLabel.Font = FONT_B
    valueLabel.TextSize = 11
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right
    valueLabel.Parent = row

    local sliderBg = Instance.new("Frame")
    sliderBg.Size = UDim2.new(1, -20, 0, 8)
    sliderBg.Position = UDim2.new(0, 10, 0, 26)
    sliderBg.BackgroundColor3 = THEME.OFF
    sliderBg.BorderSizePixel = 0
    sliderBg.Parent = row
    corner(sliderBg, 4)

    local ratio = math.clamp((default - min) / math.max(1, max - min), 0, 1)
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(ratio, 0, 1, 0)
    fill.BackgroundColor3 = THEME.ON
    fill.BorderSizePixel = 0
    fill.Parent = sliderBg
    corner(fill, 4)

    local dragging = false
    local function update(input)
        if sliderBg.AbsoluteSize.X <= 0 then return end
        local x = math.clamp(input.Position.X - sliderBg.AbsolutePosition.X, 0, sliderBg.AbsoluteSize.X)
        local r = x / sliderBg.AbsoluteSize.X
        local value = math.floor(min + (max - min) * r + 0.5)
        fill.Size = UDim2.new(r, 0, 1, 0)
        valueLabel.Text = tostring(value)
        if callback then pcall(callback, value) end
    end

    bind(sliderBg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(input)
        end
    end))
    bind(UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input)
        end
    end))
    bind(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))
end

