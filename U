playerListRefresh = function(force)
    if playerRefreshBusy then return end
    if not force and selectedTab ~= "Teleport" then return end
    playerRefreshBusy = true
    local groups = {Killers = {}, Survivors = {}, Spectating = {}}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LP then
            local role = getPlayerRoleFolder(player)
            if role ~= "Killers" and role ~= "Spectating" then role = "Survivors" end
            table.insert(groups[role], player)
        end
    end
    table.sort(groups.Killers, function(a, b) return a.DisplayName:lower() < b.DisplayName:lower() end)
    table.sort(groups.Survivors, function(a, b) return a.DisplayName:lower() < b.DisplayName:lower() end)
    table.sort(groups.Spectating, function(a, b) return a.DisplayName:lower() < b.DisplayName:lower() end)

    local signatureParts = {}
    for _, groupName in ipairs({"Killers", "Survivors", "Spectating"}) do
        for _, player in ipairs(groups[groupName]) do
            table.insert(signatureParts, playerKey(player))
        end
        table.insert(signatureParts, "|" .. groupName)
    end
    local signature = table.concat(signatureParts, ";")
    if force or signature ~= playerSignature then
        playerSignature = signature
        for _, child in ipairs(playerContainer:GetChildren()) do
            if not child:IsA("UIListLayout") then
                child:Destroy()
            end
        end
        local roleNames = {
            {"Killers", "KILLERS", Color3.fromRGB(220, 90, 90)},
            {"Survivors", "SURVIVORS", Color3.fromRGB(190, 190, 190)},
            {"Spectating", "SPECTATING", Color3.fromRGB(150, 150, 150)}
        }
        for _, info in ipairs(roleNames) do
            createRoleHeader(info[2], info[3], #groups[info[1]])
            for _, player in ipairs(groups[info[1]]) do
                local roleText, roleColor = getRoleData(player)
                createPlayerRow(player, roleText, roleColor)
            end
        end
        teleportInfo.Text = "PLAYERS: " .. tostring(#Players:GetPlayers() - 1) .. "  //  CLICK TO TELEPORT"
    end
    playerRefreshBusy = false
end

