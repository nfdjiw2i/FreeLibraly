local function RunSplash(text)
	Splash.Visible=true;Splash.BackgroundTransparency=0;SplashTitle.Text=tostring(text or "USURE");SplashTitle.TextTransparency=0;SplashStatus.TextTransparency=0;LoadBack.BackgroundTransparency=0;LoadFill.BackgroundTransparency=0
