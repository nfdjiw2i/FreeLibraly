local function genPosKey(gen)
    local pos
    if gen:IsA("Model") then
        local ok, piv = pcall(function() return gen:GetPivot().Position end)
        if ok then pos = piv end
    elseif gen:IsA("BasePart") then
        pos = gen.Position
    end
    if not pos then return nil end
    return string.format("%d_%d_%d", math.floor(pos.X / 4), math.floor(pos.Y / 4), math.floor(pos.Z / 4))
end

local function hasEnabledPrompt(gen)
