	Menu.Visible=true
end

function Library:Hide()
	if Destroying or Minimized then return end
	Minimized=true;MenuOpen=false
	local center=MenuCenter();Menu.Visible=false;CollapseParticles(center,true)
	task.delay(.4,function()if Minimized and not Destroying then CreateCollapseCube()end end)
end

function Library:Toggle()if Minimized or not Menu.Visible then self:Show()else self:Hide()end end

function Library:Destroy()
	if Destroying then return end
	Destroying=true;Menu.Visible=false
	CollapseParticles(MenuCenter(),true)
	for _,c in ipairs(Connections)do pcall(function()c:Disconnect()end)end
	task.delay(.45,function()if Gui.Parent then Gui:Destroy()end end)
end

