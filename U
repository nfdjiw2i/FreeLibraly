local function getPlayerRoleFolder(player)
    if not player or not player.Character then return "Survivors" end
    local char = player.Character
    local parent = char.Parent

    if parent and parent.Parent and parent.Parent.Name == "Players" then
        return parent.Name
    end

    local playersFolder = workspace:FindFirstChild("Players")
    if playersFolder then
        local killers = playersFolder:FindFirstChild("Killers")
        if killers and char:IsDescendantOf(killers) then return "Killers" end
        local spectating = playersFolder:FindFirstChild("Spectating")
        if spectating and char:IsDescendantOf(spectating) then return "Spectating" end
        local survivors = playersFolder:FindFirstChild("Survivors")
        if survivors and char:IsDescendantOf(survivors) then return "Survivors" end
    end
    return "Survivors"
end

