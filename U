-- SAFE REMOTE COMMAND LAYER
-- This layer accepts only predefined commands. It never executes arbitrary Lua received remotely.
local RemoteCommands={
    SHOW_MENU=function() Library:Show() end,
    HIDE_MENU=function() Library:Hide() end,
    TOGGLE_MENU=function() Library:Toggle() end,
    DESTROY_MENU=function() Library:Destroy() end,
    PRINT=function(value) print("[USURE REMOTE]",tostring(value or "")) end,
    SET_TITLE=function(value) Library:SetTitle(tostring(value or "USURE")) end,
    SET_STATUS=function(value) Library:SetStatus(tostring(value or "STATUS: READY")) end,
}

function Library:ApplyRemoteCommand(raw)
    raw=tostring(raw or "")
    raw=raw:gsub("^%s+",""):gsub("%s+$","")
    if raw=="" then return false,"empty" end

    local command,value=raw:match("^([%w_]+)%s*:%s*(.*)$")
    command=command or raw
    command=string.upper(command)

    local handler=RemoteCommands[command]
    if not handler then
        return false,"blocked"
    end

    local ok,err=pcall(handler,value)
    if not ok then
        return false,tostring(err)
    end
    return true,"ok"
end

function Library:GetRemoteCommands()
    local result={}
    for name in pairs(RemoteCommands) do result[#result+1]=name end
    table.sort(result)
    return result
end

return Library
