local origColorShiftBottom = Lighting.ColorShift_Bottom
local origExposure = Lighting.ExposureCompensation
local fullBrightEffects = {}
local appliedFullBright = nil

local function setFullBright(enabled)
    if enabled then
        Lighting.Brightness = 3
        Lighting.ClockTime = 14
        Lighting.FogEnd = 1000000
        Lighting.GlobalShadows = false
        Lighting.Ambient = Color3.fromRGB(210, 210, 210)
        Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
        Lighting.ColorShift_Top = Color3.fromRGB(255, 255, 255)
        Lighting.ColorShift_Bottom = Color3.fromRGB(255, 255, 255)
        Lighting.ExposureCompensation = 0.35
        for _, obj in ipairs(Lighting:GetChildren()) do
            if obj:IsA("Atmosphere") then
                if fullBrightEffects[obj] == nil then
                    fullBrightEffects[obj] = {
                        Density = obj.Density, Haze = obj.Haze, Glare = obj.Glare,
                        Offset = obj.Offset, Color = obj.Color, Decay = obj.Decay,
                    }
                end
                obj.Density = 0
                obj.Haze = 0
                obj.Glare = 0
            elseif obj:IsA("BloomEffect") or obj:IsA("BlurEffect")
                or obj:IsA("ColorCorrectionEffect") or obj:IsA("DepthOfFieldEffect")
                or obj:IsA("SunRaysEffect") then
                if fullBrightEffects[obj] == nil then
                    fullBrightEffects[obj] = {Enabled = obj.Enabled}
                end
                obj.Enabled = false
            end
        end
    else
        Lighting.Brightness = origBrightness
        Lighting.ClockTime = origClockTime
        Lighting.FogEnd = origFogEnd
        Lighting.GlobalShadows = origGlobalShadows
        Lighting.Ambient = origAmbient
        Lighting.OutdoorAmbient = origOutdoorAmbient
        Lighting.ColorShift_Top = origColorShiftTop
        Lighting.ColorShift_Bottom = origColorShiftBottom
        Lighting.ExposureCompensation = origExposure
        for obj, saved in pairs(fullBrightEffects) do
            if obj and obj.Parent then
                if saved.Density ~= nil then
                    obj.Density = saved.Density
                    obj.Haze = saved.Haze
                    obj.Glare = saved.Glare
                    if saved.Offset then obj.Offset = saved.Offset end
                    if saved.Color then obj.Color = saved.Color end
                    if saved.Decay then obj.Decay = saved.Decay end
                elseif saved.Enabled ~= nil then
                    obj.Enabled = saved.Enabled
                end
            end
        end
        fullBrightEffects = {}
    end
end

