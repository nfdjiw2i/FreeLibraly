    center.BorderSizePixel = 0
    center.Parent = panel
    local centerCorner = Instance.new("UICorner")
    centerCorner.CornerRadius = UDim.new(0, 5)
    centerCorner.Parent = center
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 18)
    label.Position = UDim2.new(0, 0, 1, 4)
    label.BackgroundTransparency = 1
    label.Text = "RADAR // 180 STUDS"
    label.TextColor3 = Color3.fromRGB(90, 90, 90)
    label.Font = FONT_B
    label.TextSize = 8
    label.Parent = panel
end

local function updateRadar()
    if not radarGui or not radarGui.Enabled then return end
    local panel = radarGui:FindFirstChildOfClass("Frame")
    if not panel then return end
    local camera = workspace.CurrentCamera
    local root = getRootPart()
    if not camera or not root then return end
    local used = {}
    local maxDistance = 180
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LP and player.Character then
            local target = player.Character:FindFirstChild("HumanoidRootPart") or player.Character:FindFirstChild("UpperTorso") or player.Character:FindFirstChild("Torso")
            if target then
                local offset = target.Position - root.Position
                local dist = offset.Magnitude
                if dist <= maxDistance then
                    local localX = offset:Dot(camera.CFrame.RightVector) / maxDistance
                    local localY = offset:Dot(camera.CFrame.LookVector) / maxDistance
                    local x = math.clamp(0.5 + localX * 0.45, 0.06, 0.94)
                    local y = math.clamp(0.5 - localY * 0.45, 0.06, 0.94)
                    local dot = radarDots[player] or Instance.new("Frame")
                    radarDots[player] = dot
                    dot.Size = UDim2.fromOffset(7, 7)
                    dot.AnchorPoint = Vector2.new(0.5, 0.5)
                    dot.Position = UDim2.new(x, 0, y, 0)
                    dot.BorderSizePixel = 0
                    local role = getPlayerRoleFolder(player)
                    dot.BackgroundColor3 = role == "Killers" and Color3.fromRGB(220, 90, 90) or role == "Spectating" and Color3.fromRGB(150, 150, 150) or Color3.fromRGB(230, 230, 230)
                    dot.Parent = panel
                    local dotCorner = dot:FindFirstChildOfClass("UICorner")
                    if not dotCorner then
                        dotCorner = Instance.new("UICorner")
                        dotCorner.CornerRadius = UDim.new(0, 4)
                        dotCorner.Parent = dot
                    end
                    used[player] = true
                end
            end
        end
    end
    for player, dot in pairs(radarDots) do
        if not used[player] then
            pcall(function() dot:Destroy() end)
            radarDots[player] = nil
        end
    end
end

buildRadar()
local radarAcc = 0
bind(RunService.Heartbeat:Connect(function(dt)
    if not scriptAlive or _G.__ForsakenHubGeneration ~= hubGeneration then return end
    radarAcc += dt
    if radarAcc >= 0.15 then
        radarAcc = 0
        pcall(updateRadar)
    end
end))

bind(Players.PlayerRemoving:Connect(function(player)
    local dot = radarDots[player]
    if dot then pcall(function() dot:Destroy() end) end
    radarDots[player] = nil
end))

